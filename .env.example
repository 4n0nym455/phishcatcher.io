# PhishCatcher Environment Configuration Example
# Copy this file to .env and fill in your actual values

# Application
FRONTEND_URL=http://localhost:5173
SECRET_KEY=your-secret-key-here
DEBUG=true

# PostgreSQL Configuration
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_USER=phishcatcher
POSTGRES_DB=phishcatcher

# MongoDB Configuration
MONGO_PASSWORD=your-mongo-password
MONGO_USER=phishcatcher
MONGO_DB=phishcatcher

# Redis Configuration
REDIS_PASSWORD=your-redis-password

# Database URLs (for local development)
DATABASE_URL=postgresql+asyncpg://phishcatcher:your-postgres-password@localhost:5432/phishcatcher
REDIS_URL=redis://:your-redis-password@localhost:6379/0
MONGODB_URL=mongodb://phishcatcher:your-mongo-password@localhost:27017/phishcatcher?authSource=admin

# MinIO (for Docker)
MINIO_ENDPOINT=minio:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# MinIO Configuration
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET_NAME=phishcatcher

# JWT Secrets
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_REFRESH_SECRET_KEY=your-jwt-refresh-secret-key-here

# Celery Configuration
CELERY_BROKER_URL=redis://:your-redis-password@redis:6379/0
CELERY_RESULT_BACKEND=redis://:your-redis-password@redis:6379/0

# Gmail Integration
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
GMAIL_REDIRECT_URI=http://localhost:5173/google/callback

# SendGrid SMTP
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
FROM_EMAIL=phishcatcher.io@gmail.com

# SendGrid API Configuration
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=phishcatcher.io@gmail.com
SENDGRID_FROM_NAME=PhishCatcher

# Threat Intelligence APIs
VIRUSTOTAL_API_KEY=your-virustotal-api-key
PHISHTANK_API_KEY=your-phishtank-api-key
HIBP_API_KEY=your-hibp-api-key
URLSCAN_API_KEY=your-urlscan-api-key

# CORS Configuration
CORS_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# Admin Account
ADMIN_EMAIL=admin@phishcatcher.co.ke
ADMIN_PASSWORD=your-admin-password

# Application Settings
LOG_LEVEL=INFO
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=5

# Session Management Settings
ACCESS_TOKEN_EXPIRE_MINUTES=120        # Access token expiry in minutes (2 hours)
REFRESH_TOKEN_EXPIRE_DAYS=7            # Refresh token expiry in days
SESSION_INACTIVITY_MINUTES=60           # Session inactivity timeout in minutes
SESSION_MAX_DURATION_MINUTES=240        # Maximum session duration in minutes
SESSION_CHECK_INTERVAL_MINUTES=15       # Session activity check interval in minutes
OTP_EXPIRE_MINUTES=10                  # OTP expiry in minutes

# File Upload Settings
MAX_FILE_SIZE_MB=50
